#!/usr/bin/env bash
#process management
pid_file="/var/run/my_process.pid"
script="./manage_my_process"

start() {
    "$script" &
    echo $! > "$pid_file"
    echo "manage_my_process started"
}

stop() {
    if [ -f "$pid_file" ]; then
        pid=$(cat "$pid_file")
        kill "$pid"
        rm -f "$pid_file"
        echo "manage_my_process stopped"
    fi
}

restart() {
    if [ -f "$pid_file" ]; then
        pid=$(cat "$pid_file")
        kill "$pid"
        rm -f "$pid_file"
    fi
    "$script" &
    echo $! > "$pid_file"
    echo "manage_my_process restarted"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        exit 1
        ;;
esac

